{
  "item": [
    {
      "id": "56194f7d-73bb-4eaf-a173-b4d6bead8968",
      "name": "Reports",
      "description": {
        "content": "Operations for creating and configuring linked Looker Studio reports.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "080b140b-69e0-4f58-9947-ba2accb0e12d",
          "name": "Looker Studio Create a linked report",
          "request": {
            "name": "Looker Studio Create a linked report",
            "description": {
              "content": "Creates a dynamic URL that directs users to a pre-configured Looker Studio report. The URL can specify a template report, configure data sources, set the initial mode (view or edit), and customize report behavior. Users who follow the link see the pre-configured report and can click \"Edit and share\" to save a personal copy.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reporting",
                "create"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "c.reportId",
                  "value": "<string>",
                  "description": "The template report ID. If omitted, a blank report is used as the template."
                },
                {
                  "disabled": false,
                  "key": "c.pageId",
                  "value": "<string>",
                  "description": "The page ID to display when the report loads. If omitted, the first page is shown."
                },
                {
                  "disabled": false,
                  "key": "c.mode",
                  "value": "<string>",
                  "description": "The initial mode for the report. Use 'view' for view mode or 'edit' for edit mode."
                },
                {
                  "disabled": false,
                  "key": "c.explain",
                  "value": "<boolean>",
                  "description": "When set to true, enables a debug dialog that shows how the Linking API parameters are being interpreted."
                },
                {
                  "disabled": false,
                  "key": "r.reportName",
                  "value": "<string>",
                  "description": "Sets the name for the new report."
                },
                {
                  "disabled": false,
                  "key": "r.measurementId",
                  "value": "<string>",
                  "description": "Configures Google Analytics measurement IDs for the report."
                },
                {
                  "disabled": false,
                  "key": "r.keepMeasurementId",
                  "value": "<boolean>",
                  "description": "When set to true, preserves the template report's measurement IDs."
                },
                {
                  "disabled": false,
                  "key": "ds.ds0.connector",
                  "value": "<string>",
                  "description": "Specifies the connector type for data source ds0. When set, the template data source configuration is completely replaced and all required connector parameters must be specified. Supported connectors include bigQuery, cloudSpanner, communityConnector, googleAnalytics, googleCloudStorage, googleSheets, looker, and searchConsole."
                },
                {
                  "disabled": false,
                  "key": "ds.ds0.datasourceName",
                  "value": "<string>",
                  "description": "Sets a custom name for data source ds0."
                },
                {
                  "disabled": false,
                  "key": "ds.ds0.refreshFields",
                  "value": "<boolean>",
                  "description": "When set to true, refreshes the field definitions for data source ds0 after configuration."
                },
                {
                  "disabled": false,
                  "key": "ds.ds0.projectId",
                  "value": "<string>",
                  "description": "The Google Cloud project ID for data source ds0. Used with BigQuery, Cloud Spanner, and Google Cloud Storage connectors."
                },
                {
                  "disabled": false,
                  "key": "ds.ds0.datasetId",
                  "value": "<string>",
                  "description": "The BigQuery dataset ID for data source ds0. Used with the BigQuery connector."
                },
                {
                  "disabled": false,
                  "key": "ds.ds0.tableId",
                  "value": "<string>",
                  "description": "The BigQuery table ID for data source ds0. Used with the BigQuery TABLE connector type."
                },
                {
                  "disabled": false,
                  "key": "ds.ds0.type",
                  "value": "<string>",
                  "description": "The BigQuery query type. Use TABLE for standard table access or CUSTOM_QUERY for SQL queries."
                },
                {
                  "disabled": false,
                  "key": "ds.ds0.sql",
                  "value": "<string>",
                  "description": "The SQL query for BigQuery CUSTOM_QUERY type data sources."
                },
                {
                  "disabled": false,
                  "key": "ds.ds0.spreadsheetId",
                  "value": "<string>",
                  "description": "The Google Sheets spreadsheet ID for data source ds0."
                },
                {
                  "disabled": false,
                  "key": "ds.ds0.worksheetId",
                  "value": "<string>",
                  "description": "The worksheet ID within a Google Sheets spreadsheet."
                },
                {
                  "disabled": false,
                  "key": "ds.ds0.hasHeader",
                  "value": "<boolean>",
                  "description": "Whether the Google Sheets data source has a header row."
                },
                {
                  "disabled": false,
                  "key": "ds.ds0.includeHiddenCells",
                  "value": "<boolean>",
                  "description": "Whether to include hidden and filtered cells from Google Sheets."
                },
                {
                  "disabled": false,
                  "key": "ds.ds0.accountId",
                  "value": "<string>",
                  "description": "The Google Analytics account ID for data source ds0."
                },
                {
                  "disabled": false,
                  "key": "ds.ds0.propertyId",
                  "value": "<string>",
                  "description": "The Google Analytics property ID for data source ds0."
                },
                {
                  "disabled": false,
                  "key": "ds.ds0.viewId",
                  "value": "<string>",
                  "description": "The Google Analytics view ID for data source ds0."
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
