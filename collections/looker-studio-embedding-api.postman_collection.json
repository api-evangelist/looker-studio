          "id": "50bbb0d5-7fc5-46dd-8347-d6d9889f1b35",
          "name": "Looker Studio Get report via short link",
          "request": {
            "name": "Looker Studio Get report via short link",
            "description": {
              "content": "Access a Looker Studio report using a shortened sharing URL. These URLs are generated by the Looker Studio sharing interface and can be used for oEmbed-compatible embedding on platforms such as Medium and Reddit.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "s",
                ":shortId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "shortId",
                  "description": "(Required) The short link identifier for the shared report."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
