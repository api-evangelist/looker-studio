  "info": {
    "_postman_id": "dd9eccd4-af8a-42e6-8d6d-c421abb32f7e",
    "name": "Looker Studio Embedding API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Embed Looker Studio reports in your applications using HTML iframe tags, oEmbed, and Open Graph Tags with customizable parameters and filtering options. Supports embedding on platforms like Medium and Reddit. Reports are embedded via URL-based configuration specifying the report ID, page, and optional filter parameters.\n\nContact Support:\n Name: Google",
      "type": "text/plain"
    }
  }
