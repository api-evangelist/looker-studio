      "id": "607f0716-556c-439d-90a2-c85b32cfc59f",
      "name": "Embed",
      "description": {
        "content": "Operations for embedding Looker Studio reports in external applications and websites.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "87e95dc7-4669-4515-ab29-17034bb30c81",
          "name": "Looker Studio Get an embedded report page",
          "request": {
            "name": "Looker Studio Get an embedded report page",
            "description": {
              "content": "Returns an embeddable version of a Looker Studio report page designed for use within an HTML iframe. The embedded report renders the specified page of the report with optional filter parameters. Users must have at least view access to the report to see the embedded content.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "embed",
                "reporting",
                ":reportId",
                "page",
                ":pageId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "params",
                  "value": "<string>",
                  "description": "URL-encoded JSON string containing filter parameters to apply to the embedded report. Filters restrict the data displayed based on dimension values."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "reportId",
                  "description": "(Required) The unique identifier of the Looker Studio report to embed."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "pageId",
                  "description": "(Required) The identifier of the specific page within the report to display."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
