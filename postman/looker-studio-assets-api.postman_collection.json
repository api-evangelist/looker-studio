  "info": {
    "_postman_id": "cd058cca-ab50-44db-8fb2-8f73e4461f71",
    "name": "Looker Studio Assets API",
    "description": "The Looker Studio API enables developers to programmatically manage reports, data sources, and permissions. It provides methods for searching assets and managing asset permissions including getting, updating, adding, and removing members. The API is available to users that belong to an organization with Google Workspace or Cloud Identity.\n\nContact Support:\n Name: Google",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T02:07:34.000Z",
    "updatedAt": "2026-07-28T02:07:34.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-cd058cca-ab50-44db-8fb2-8f73e4461f71"
  },
